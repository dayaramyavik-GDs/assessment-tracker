<?xml version='1.0' encoding='utf-8'?>
<widget id="au.edu.cqu.dayaram.assessmenttracker" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  <name>Assessment Tracker</name>
  <description>University assessment deadline and grade planner.</description>
  <author email="dayaram.yavik@gmail.com">Yavik Dayaram</author>
  <content src="index.html" />

  <access origin="http://localhost:3000" />
  <access origin="https://assessment-tracker-api.onrender.com" />

  <preference name="Orientation" value="portrait" />
  <preference name="android-minSdkVersion" value="24" />

  <platform name="android">
    <resource-file src="res/android/network_security_config.xml"
                   target="app/src/main/res/xml/network_security_config.xml" />
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
      <application android:networkSecurityConfig="@xml/network_security_config" />
    </edit-config>
  </platform>
</widget>